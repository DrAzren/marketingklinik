{
  "name": "klinik-nissa-ig-story",
  "version": "1.0.0",
  "description": "Klinik Nissa 20s Instagram Story motion infographic (HyperFrames + GSAP)",
  "scripts": {
    "audio": "python3 tools/make_audio.py",
    "lint": "hyperframes lint",
    "snapshot": "hyperframes snapshot --at 1.6,4.8,9.5,14.5,19.9 --describe false",
    "render": "hyperframes render --resolution portrait-4k -f 60 -q high --video-bitrate 24M -o renders/klinik-nissa-ig-story-20s-4k60.mp4",
    "render:preview": "hyperframes render -f 30 -q draft -o renders/preview-1080p.mp4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrAzren/marketingklinik.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DrAzren/marketingklinik/issues"
  },
  "homepage": "https://github.com/DrAzren/marketingklinik#readme",
  "devDependencies": {
    "@fontsource/poppins": "5.1.0",
    "gsap": "3.13.0",
    "hyperframes": "0.8.134"
  },
  "private": true
}
