 "captions": [
  [0.94, 4.98, "Di sebalik setiap senyuman... tersembunyi satu persaingan."],
  [5.54, 9.2, "Tahun ini, hanya yang terbaik akan menguasai permainan."],
  [9.72, 12.4, "Misi pertama... Operation Blackout."],
  [12.76, 16.65, "Kebijaksanaan, kerjasama dan keupayaan menyelesaikan masalah"],
  [16.9, 19.1, "akan menentukan nasib pasukan anda."],
  [19.62, 21.75, "Empat cabaran. Empat peluang."],
  [22.06, 24.6, "Setiap ahli mempunyai kekuatan tersendiri."],
  [24.96, 26.9, "Pilih wakil anda dengan bijak..."],
  [27.18, 30.45, "kerana lawan anda mungkin sudah mempunyai strategi."],
  [33.74, 37.4, "Tetapi ingat... bukan semua rakan akan kekal di pihak anda."],
  [37.86, 42.2, "Dalam Psychology Betrayal, kepercayaan mungkin menjadi kelemahan terbesar."],
  [42.62, 47.65, "Dan apabila malam menjelma... setiap kata akan dipersoalkan."],
  [48.12, 50.7, "Setiap keputusan membawa akibat."],
  [51.1, 54.0, "Siapa yang benar-benar boleh dipercayai?"],
  [54.32, 55.85, "Rebut gelaran juara!"],
  [56.0, 58.1, "Hadiah utama RM150,"],
  [58.26, 61.95, "tempat kedua RM100, dan tempat ketiga RM50!"],
  [63.02, 65.2, "Anda tahu kemahiran yang diperlukan..."],
  [65.6, 68.6, "tetapi belum tahu permainan yang menanti."],
